# Copy to deploy/.env on the VPS. Never commit it. Generate secrets with: openssl rand -hex 32

# --- Domains (DNS A records for both must point at the VPS; keep them on one registrable domain) ---
SITE_DOMAIN=www.example.com
# The bare domain: redirects to SITE_DOMAIN. Needs its own DNS A record pointing at the VPS.
APEX_DOMAIN=example.com
API_DOMAIN=api.example.com
ACME_EMAIL=ops@example.com
# Host (no scheme) of the CDN in front of the R2 bucket, e.g. media.example.com. Build-time for the storefront.
MEDIA_HOST=

# --- Data stores (hex values only: they are embedded in connection URLs) ---
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# --- API ---
# 1 = Caddy only; 2 = Cloudflare proxy (orange cloud) in front of Caddy.
TRUSTED_PROXY_HOPS=1
LOG_LEVEL=info
CORS_ORIGINS=https://www.example.com
AUTH_TOKEN_SECRET=
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=https://www.example.com/checkout/return
# Lets admin edits appear on the storefront at once (shared with the storefront container).
STOREFRONT_REVALIDATE_URL=http://frontend:3000/api/revalidate
REVALIDATE_SECRET=
OPS_ALERT_EMAIL=ops@example.com

# --- Notifications (production refuses the 'log' providers) ---
SMS_PROVIDER=termii
TERMII_API_KEY=
TERMII_SENDER_ID=
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=Jetty's Hairs <orders@example.com>

# --- Media (Cloudflare R2) ---
MEDIA_S3_ENDPOINT=
MEDIA_S3_BUCKET=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_S3_REGION=auto
MEDIA_PUBLIC_BASE_URL=