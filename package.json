{
  "name": "jetty",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for Jetty's Hair — Next.js storefront and hapi commerce API",
  "license": "MIT",
  "workspaces": [
    "frontend",
    "api",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace @jetty/api",
    "dev:web": "npm run dev --workspace @jetty/frontend",
    "build": "npm run build --workspaces --if-present",
    "build:api": "npm run build --workspace @jetty/api",
    "build:web": "npm run build --workspace @jetty/frontend",
    "start:api": "npm run start --workspace @jetty/api",
    "start:web": "npm run start --workspace @jetty/frontend",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "check": "npm run typecheck && npm run lint && npm run test",
    "clean": "rm -rf node_modules frontend/node_modules frontend/.next api/node_modules api/dist"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  },
  "engines": {
    "node": ">=22.18",
    "npm": ">=10"
  }
}
