# Copy to .env.local for local development.

# Base URL of the hapi API, used by server components, route handlers and
# server actions. Not exposed to the browser.
API_BASE_URL=http://localhost:4000/api/v1

# Same value when the browser must call the API directly. Anything prefixed
# NEXT_PUBLIC_ is inlined into the client bundle, so never put a secret here.
# In production the API lives on a subdomain of the storefront's domain
# (e.g. https://api.example.com/api/v1) so its cookies are same-site.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# Host of the CDN in front of the media bucket (no scheme), e.g. media.example.com.
# When set, product images go through next/image; otherwise they are used as-is.
# NEXT_PUBLIC_MEDIA_HOST=

# Public address of the storefront (no trailing slash). Used for canonical links, the sitemap, robots.txt, link
# previews and structured data. Set it in production; local development falls back to http://localhost:3000.
# NEXT_PUBLIC_SITE_URL=https://www.example.com
