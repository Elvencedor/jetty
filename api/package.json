{
  "name": "@jetty/api",
  "version": "0.1.0",
  "private": true,
  "description": "Jetty commerce API (hapi)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "dev:webhook": "tsx watch --env-file-if-exists=.env src/webhook/index.ts",
    "start:webhook": "node --env-file-if-exists=.env dist/webhook/index.js",
    "dev:worker": "tsx watch --env-file-if-exists=.env src/worker/index.ts",
    "start:worker": "node --env-file-if-exists=.env dist/worker/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "db:check": "drizzle-kit check",
    "db:seed": "tsx --env-file-if-exists=.env src/db/seed.ts",
    "lint": "eslint src"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@hapi/hapi": "^21.4.10",
    "drizzle-orm": "^0.45.4",
    "ioredis": "^6.0.0",
    "joi": "^18.2.9",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.18"
  }
}
