# Copy to .env for local development. Never commit real credentials.
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=debug

# HMAC key for customer access tokens (32+ chars): openssl rand -base64 48
# AUTH_TOKEN_SECRET=

# Comma-separated browser origins permitted to call the API.
CORS_ORIGINS=http://localhost:3000

# Added as the services in docs/INFRASTRUCTURE.md are provisioned:
# PostgreSQL 16+ connection string; required for npm run db:migrate
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/jetty
# PAYSTACK_SECRET_KEY=
# PAYSTACK_CALLBACK_URL=https://shop.example.com/checkout/return
# PAYSTACK_BASE_URL=https://api.paystack.co
# Webhook service only (npm run start:webhook): defaults to PAYSTACK_SECRET_KEY, which Paystack signs with.
# PAYSTACK_WEBHOOK_SECRET=
# WEBHOOK_PORT=4001

# Used only by npm run db:seed to create the first owner admin (password min 12 chars).
# Never commit real values; remove from .env after seeding.
# SEED_OWNER_EMAIL=
# SEED_OWNER_PASSWORD=

# Disposable PostgreSQL server for integration tests (each test file creates and
# drops its own database). Start one with: docker compose up -d --wait
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:55432/postgres
