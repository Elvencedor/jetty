# Copy to .env for local development. Never commit real credentials.
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=debug

# HMAC key for customer access tokens (32+ chars): openssl rand -base64 48
# AUTH_TOKEN_SECRET=

# Comma-separated browser origins permitted to call the API.
CORS_ORIGINS=http://localhost:3000

# Added as the services in docs/INFRASTRUCTURE.md are provisioned:
# PostgreSQL 16+ connection string; required for npm run db:migrate
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/jetty
# PAYSTACK_SECRET_KEY=
# PAYSTACK_CALLBACK_URL=https://shop.example.com/checkout/return
# PAYSTACK_BASE_URL=https://api.paystack.co
# Webhook service only (npm run start:webhook): defaults to PAYSTACK_SECRET_KEY, which Paystack signs with.
# PAYSTACK_WEBHOOK_SECRET=
# WEBHOOK_PORT=4001

# Used only by npm run db:seed to create the first owner admin (password min 12 chars).
# Never commit real values; remove from .env after seeding.
# SEED_OWNER_EMAIL=
# SEED_OWNER_PASSWORD=

# Disposable PostgreSQL server for integration tests (each test file creates and
# drops its own database). Start one with: docker compose up -d --wait
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:55432/postgres

# Rate limiting (Redis-backed). On by default except under NODE_ENV=test, so REDIS_URL is then required.
# RATE_LIMIT_ENABLED=true
# REDIS_URL=redis://localhost:6379
# Number of trusted proxies in front of the API; 0 uses the socket address and ignores x-forwarded-for.
# TRUSTED_PROXY_HOPS=1
# Domain for the per-phone placeholder email sent to Paystack when a customer has no email.
# PAYSTACK_PLACEHOLDER_EMAIL_DOMAIN=noemail.jettyshair.com

# Notifications, sent by the worker (npm run start:worker) from the outbox.
# 'log' prints messages, including one-time codes, and is refused in production.
# SMS_PROVIDER=termii
# TERMII_API_KEY=
# TERMII_SENDER_ID=
# TERMII_BASE_URL=https://api.ng.termii.com
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# EMAIL_FROM=Jetty's Hair <orders@example.com>

# Product media: S3-compatible bucket (Cloudflare R2). Upload intents return 503 until all four are set.
# MEDIA_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# MEDIA_S3_BUCKET=
# MEDIA_S3_ACCESS_KEY_ID=
# MEDIA_S3_SECRET_ACCESS_KEY=
# MEDIA_S3_REGION=auto

# Payment exceptions (duplicate / late / mismatched charges) are emailed here by the worker; they are always logged.
# OPS_ALERT_EMAIL=ops@example.com
